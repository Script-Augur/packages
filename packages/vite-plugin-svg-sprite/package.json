{
  "name": "@script-augur/vite-plugin-svg-sprite",
  "version": "0.2.1",
  "description": "Vite plugin that builds an SVG sprite, optional SVGO, and TypeScript symbol ID types",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Script-Augur/packages.git",
    "directory": "packages/vite-plugin-svg-sprite"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "svgo": ">=3",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "svgo": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
